  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "If you found this\u2026 you\u2019re already too late.\r\nI thought it
    was just a school.\r\nBut everything feels wrong\u2026\r\nIt\u2019s too clean.\r\nToo
    perfect.\r\nNot a single thing out of place.\r\nLike no one has been here\u2026
    yet nothing is abandoned.\r\nThen the bell started ringing.\r\nAt first\u2026
    nothing.\r\nThen I heard footsteps.\r\nNot mine.\r..\nSomething began following
    me.\r\nCloser.\r..\nEvery time the bell rings\u2026 it gets worse.\r\nIf the
    bell keeps ringing\u2026 you need to leave.\r Before the eighth.\r\nDon\u2019t
    wait.\r\nI did.\r\n\u2026It\u2019s still here."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: f2d4669de1a01f7419bf06b44e525f20, type: 2}
